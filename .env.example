# ── Dense enrichment（可选）──────────────────────────────────────
# 结构索引、Wiki 和 Exact/FTS5/Graph 检索不需要任何远程 API key。
# 仅在启用 dense enrichment 时填写 provider 对应的密钥。
# 默认 provider 使用百炼 DashScope。
DASHSCOPE_API_KEY=

# provider 标识与 `.indexer.toml` 的 `[embedding]` 一致。
EMBEDDING_PROVIDER=dashscope/text-embedding-v4
# 密钥所在的环境变量名，不是密钥值本身。
EMBEDDING_API_KEY_ENV=DASHSCOPE_API_KEY
# OpenAI-compatible embedding endpoint。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 向量维度。修改 provider 或维度后，需要重新执行 enrichment。
EMBEDDING_DIMENSIONS=1024

# ── REST API 与 Web 控制台 ───────────────────────────────────────
API_PORT=7654
# 设置后，受保护的 REST 请求需 `Authorization: Bearer <key>`。
REPO_WIKI_API_KEY=
# 生成 Webhook URL 时使用的公网域名；未部署公网服务时留空。
PUBLIC_DOMAIN=
# GitHub 使用 HMAC-SHA256，GitLab 使用 Token header。
WEBHOOK_SECRET=

# ── MCP（可选）──────────────────────────────────────────────────
# Docker 启动时设为 true，会同时启动 streamable HTTP MCP。
MCP_ENABLED=false
MCP_PORT=8000
MCP_API_KEY=
